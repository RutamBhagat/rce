{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@rce/auth": "workspace:*",
    "@rce/db": "workspace:*",
    "@rce/env": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "elysia": "1.4.29",
    "libsql": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rce/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
