{
  "name": "rce-mcp",
  "version": "0.1.23",
  "description": "Run rce in a project to expose OAuth-protected MCP coding tools for ChatGPT over a stable HTTPS tunnel.",
  "type": "module",
  "bin": {
    "rce": "dist/index.mjs"
  },
  "files": [
    "dist",
    "DISCLOSURE"
  ],
  "contentPolicy": {
    "class": "dual-use"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RutamBhagat/rce.git",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/RutamBhagat/rce#readme",
  "bugs": {
    "url": "https://github.com/RutamBhagat/rce/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:css && npm run build:app",
    "build:server": "tsdown",
    "build:css": "tailwindcss -i ./src/consent.css -o ./dist/consent.css --minify",
    "build:app": "vite build --config vite.app.config.ts",
    "check-types": "tsc -b",
    "dev": "npm run build:css && npm run build:app && node --watch src/index.ts",
    "smoke:dist": "node scripts/smoke-built-cli.mjs",
    "start": "node dist/index.mjs",
    "test": "node --test src/*.test.ts src/services/*.test.ts",
    "prepack": "npm run build && node scripts/readme.mjs copy",
    "postpack": "node scripts/readme.mjs clean"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.2",
    "@better-auth/memory-adapter": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@clack/prompts": "1.7.0",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@elysia/node": "1.4.6",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/server": "2.0.0",
    "@openai/codex": "0.153.4",
    "@pierre/diffs": "1.4.1",
    "@remix-run/html-template": "0.3.1",
    "better-auth": "1.7.2",
    "diff": "9.0.0",
    "elysia": "1.4.30",
    "env-paths": "4.0.0",
    "pi-mcp-adapter": "2.32.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-json-view-lite": "2.5.0"
  },
  "devDependencies": {
    "@better-auth/cimd": "1.7.2",
    "@tailwindcss/cli": "4.3.3",
    "@types/cross-spawn": "6.0.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3"
  }
}
