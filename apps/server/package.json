{
  "name": "rce-mcp",
  "version": "0.1.0",
  "description": "Expose the current local project through an OAuth-protected MCP coding server.",
  "type": "module",
  "bin": {
    "rce": "dist/index.mjs"
  },
  "files": [
    "dist",
    "DISCLOSURE"
  ],
  "contentPolicy": {
    "class": "dual-use"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RutamBhagat/rce.git",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/RutamBhagat/rce#readme",
  "bugs": {
    "url": "https://github.com/RutamBhagat/rce/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.2",
    "@better-auth/memory-adapter": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@elysia/node": "1.4.6",
    "@modelcontextprotocol/server": "2.0.0",
    "@openai/codex": "0.153.4",
    "@remix-run/html-template": "0.3.1",
    "better-auth": "1.7.2",
    "elysia": "1.4.30",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@better-auth/cimd": "1.7.2",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
