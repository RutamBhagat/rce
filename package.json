{
  "name": "rce",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "@types/node": "^24.13.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "start": "bun run --filter '*' start",
    "check-types": "bun run --filter '*' check-types",
    "dev:server": "bun run --filter rce-mcp dev"
  },
  "devDependencies": {
    "@rce/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "patchedDependencies": {
    "@better-auth/cimd@1.7.2": "patches/@better-auth%2Fcimd@1.7.2.patch"
  },
  "packageManager": "bun@1.4.0"
}
